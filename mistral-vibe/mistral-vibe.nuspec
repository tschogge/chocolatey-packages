<?xml version="1.0" encoding="utf-8"?>
<!-- Do not remove this test for UTF-8: if "Ω" doesn't appear as greek uppercase omega letter
enclosed in quotation marks, you should use an editor that supports UTF-8, not this one. -->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <!-- == PACKAGE SPECIFIC SECTION == -->
    <id>mistral-vibe</id>
    <version>2.8.1</version>
    <packageSourceUrl>https://github.com/tschogge/chocolatey-packages/tree/main/mistral-vibe</packageSourceUrl>
    <!-- owners is a poor name for maintainers of the package. It sticks around by this name for
    compatibility reasons. It basically means you. -->
    <owners>Tschogge</owners>
    <!-- ============================== -->

    <!-- == SOFTWARE SPECIFIC SECTION == -->
    <title>mistral-vibe</title>
    <authors>Mistral</authors>
    <!-- projectUrl is required for the community feed -->
    <projectUrl>https://mistral.ai/products/vibe</projectUrl>
    <projectSourceUrl>https://github.com/mistralai/mistral-vibe</projectSourceUrl>
    <!-- There are a number of CDN Services that can be used for hosting the Icon for a package.
    More information can be found here:
    https://docs.chocolatey.org/en-us/create/create-packages#package-icon-guidelines -->
    <!-- Here is an example using Githack -->
    <iconUrl>
      https://raw.githubusercontent.com/tschogge/chocolatey-packages/b4c21a1ede8f5d46afae37e23cc74c26207f901f/mistral-vibe/vibe-logo.svg</iconUrl>
    <copyright>2026 Mistral</copyright>
    <!-- If there is a license Url available, it is required for the community feed -->
    <licenseUrl>https://github.com/mistralai/mistral-vibe/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <docsUrl>https://docs.mistral.ai/mistral-vibe/overview</docsUrl>
    <mailingListUrl>https://github.com/mistralai/mistral-vibe/discussions</mailingListUrl>
    <bugTrackerUrl>https://github.com/mistralai/mistral-vibe/issues</bugTrackerUrl>
    <tags>mistral-vibe vibe coding-agent ai cli developer-tools mistral</tags>
    <summary>Mistral's open-source CLI coding assistant powered by Devstral.</summary>
    <description>
      Mistral Vibe is a command-line coding assistant that provides a conversational interface to
      your codebase.

      Key Features:
      - Interactive chat interface right in your terminal
      - Multi-file context maintenance and autonomous shell command execution
      - Support for file path autocompletion, shell commands, and slash command skills
      - Integration with JetBrains and Zed via Agent Communication Protocol
      - Offline capability with locally deployed models
      - Multiple built-in agent profiles (default, plan, accept-edits, auto-approve)
      - Subagents for task delegation
      - Skills system for extending functionality
      - Highly configurable via config.toml
      - Safety features including tool execution approval and trust folder system

      Vibe works on Windows, Linux, and macOS (officially targets UNIX environments).

      Project Homepage: https://mistral.ai/products/vibe
    </description>
    <releaseNotes>
      ## v2.8.1 (April 21, 2026)

      Latest release with various improvements and bug fixes.

      See full changelog: https://github.com/mistralai/mistral-vibe/blob/main/CHANGELOG.md
    </releaseNotes>
    <!-- =============================== -->

