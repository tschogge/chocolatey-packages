<?xml version="1.0" encoding="utf-8"?>
<!-- Do not remove this test for UTF-8: if “Ω” doesn’t appear as greek uppercase omega letter
enclosed in quotation marks, you should use an editor that supports UTF-8, not this one. -->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <!-- == PACKAGE SPECIFIC SECTION == -->
    <id>ashampoo-app</id>
    <version>2.18.1</version>
    <packageSourceUrl>https://github.com/tschogge/chocolatey-packages/tree/main/ashampoo-app</packageSourceUrl>
    <owners>tschogge</owners>
    <!-- ============================== -->

    <!-- == SOFTWARE SPECIFIC SECTION == -->
    <title>ashampoo-app (Install)</title>
    <authors>Ashampoo GmbH &amp; Co. KG</authors>
    <!-- projectUrl is required for the community feed -->
    <projectUrl>https://www.ashampoo.com/de-de/app</projectUrl>
    <!-- There are a number of CDN Services that can be used for hosting the Icon for a package.
    More information can be found here:
    https://docs.chocolatey.org/en-us/create/create-packages#package-icon-guidelines -->
    <iconUrl>https://sih.ashampoo.com/fit-in/160x0/images/products/0401/boxshot.png</iconUrl>
    <copyright>2026 Ashampoo</copyright>
    <!-- If there is a license Url available, it is required for the community feed -->
    <!-- <licenseUrl>Software License Location __REMOVE_OR_FILL_OUT__</licenseUrl>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>-->
    <!--<projectSourceUrl>Software
    Source Location - is the software FOSS somewhere? Link to it with this</projectSourceUrl>-->
    <docsUrl>https://www.ashampoo.com/de-de/app#product-navigation</docsUrl>
    <!--<mailingListUrl></mailingListUrl>-->
    <!--<bugTrackerUrl></bugTrackerUrl>-->
    <tags>ashampoo-app ashampoo optimizer app-installer</tags>
    <summary>Install all Ashampoo products on your Windows device within one app.</summary>
    <description>With the Ashampoo app, you have everything you need in one place: discovering,
      managing, downloading and updating has never been easier. The app delivers all Ashampoo and
      partner products to you in one place – quickly, easily and free of charge!

      Your licences are managed securely and clearly
      Your software and the app are automatically kept up to date – conveniently and reliably
      Support is just a click away, with quick help exactly when you need it</description>
    <!-- <releaseNotes>__REPLACE_OR_REMOVE__MarkDown_Okay</releaseNotes> -->
    <!-- =============================== -->
  </metadata>
  <files>
    <!-- this section controls what actually gets packaged into the Chocolatey package -->
    <file src="tools\**" target="tools" />
  </files>
</package>